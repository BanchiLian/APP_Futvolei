// FutCheck data model.
//
// Conventions:
// - Every table has a uuid id, `created_at` and `updated_at`.
// - Instants are `timestamptz` (UTC). Business-local reasoning belongs to
//   `packages/shared/src/date.ts`, never to the database.
// - Enum values mirror `packages/shared/src/enums.ts`, and a test asserts parity.
// - Extra guarantees that Prisma cannot express (the single-super-admin partial
//   index, CHECK constraints) live in raw SQL inside the migration.

// The `prisma-client` generator emits TypeScript, so the output lives inside
// `src/` where tsc compiles it into `dist/`. The folder is git-ignored.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma.config.ts (Prisma 7).
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  PROFESSOR
  ALUNO
  DAYUSE
}

enum SessionType {
  AULA
  DAYUSE
}

enum SessionStatus {
  ABERTA
  CANCELADA
  ENCERRADA
}

enum BookingStatus {
  CONFIRMADA
  NAO_VOU
  LISTA_ESPERA
  CANCELADA_PELA_ARENA
  PRESENTE
  FALTOU
}

enum SkillLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

// -----------------------------------------------------------------------------
// Users
// -----------------------------------------------------------------------------

model User {
  id String @id @default(uuid(7)) @db.Uuid

  name String @db.VarChar(120)

  /// Always written lowercase (see `emailSchema` in packages/shared), which is
  /// what makes the unique constraint behave case-insensitively.
  email String @unique @db.VarChar(255)

  /// Digits only, 10–11 chars (Brazilian numbers).
  phone String @db.VarChar(11)

  passwordHash String @map("password_hash") @db.VarChar(255)

  /// Public sign-up always writes DAYUSE. SUPER_ADMIN is only ever written by
  /// `npm run superadmin:create` and is capped at one row by a partial index.
  role Role @default(DAYUSE)

  avatarUrl          String? @map("avatar_url") @db.VarChar(500)
  avatarThumbnailUrl String? @map("avatar_thumbnail_url") @db.VarChar(500)

  birthDate  DateTime?   @map("birth_date") @db.Date
  skillLevel SkillLevel? @map("skill_level")

  isActive Boolean @default(true) @map("is_active")

  /// LGPD: when the user accepted the terms of use.
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)

  /// Soft delete / anonymisation. History is preserved for statistics.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings            Booking[]           @relation("BookingUser")
  attendanceMarked    Booking[]           @relation("BookingCheckedInBy")
  responsibleFor      ScheduleTemplate[]  @relation("TemplateResponsible")
  sessionsResponsible Session[]           @relation("SessionResponsible")
  sessionsCreated     Session[]           @relation("SessionCreatedBy")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]          @relation("AuditActor")
  settingsUpdated     Setting[]           @relation("SettingUpdatedBy")

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Tokens
// -----------------------------------------------------------------------------

model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Only the hash is stored — a leaked database cannot mint sessions.
  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Schedule — the editable weekly grid. Aula vs dayuse is data, never `if (weekday)`.
// -----------------------------------------------------------------------------

model ScheduleTemplate {
  id String @id @default(uuid(7)) @db.Uuid

  type SessionType

  /// 0 = Sunday … 6 = Saturday, in the business timezone.
  weekday Int @db.SmallInt

  /// Wall-clock `HH:mm` in the business timezone, turned into a UTC instant by
  /// `businessDateTime()` when sessions are generated. A CHECK constraint in the
  /// migration enforces the format.
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  capacity Int

  /// Required for AULA, optional for DAYUSE (CHECK constraint in the migration).
  responsibleId String? @map("responsible_id") @db.Uuid

  title    String? @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  responsible User?     @relation("TemplateResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  sessions    Session[]

  @@index([type, weekday, isActive])
  @@index([responsibleId])
  @@map("schedule_templates")
}

// -----------------------------------------------------------------------------
// Sessions — concrete occurrences
// -----------------------------------------------------------------------------

model Session {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for ad-hoc sessions created by an admin (a holiday "aulão", say).
  templateId String? @map("template_id") @db.Uuid

  type     SessionType
  startsAt DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime    @map("ends_at") @db.Timestamptz(3)

  /// Copied from the template at generation time, then editable per session.
  capacity      Int
  responsibleId String? @map("responsible_id") @db.Uuid
  title         String? @db.VarChar(120)

  status       SessionStatus @default(ABERTA)
  cancelReason String?       @map("cancel_reason") @db.VarChar(255)
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdById  String?       @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  template    ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  responsible User?             @relation("SessionResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookings    Booking[]

  /// Makes generation idempotent: the same template slot can only exist once.
  /// Postgres treats NULLs as distinct, so ad-hoc sessions are unaffected.
  @@unique([templateId, startsAt], map: "sessions_template_slot_key")
  @@index([startsAt, type])
  @@index([status, startsAt])
  @@index([responsibleId, startsAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// Bookings — the RSVP and the attendance mark live on one row, in distinct fields.
// -----------------------------------------------------------------------------

model Booking {
  id        String @id @default(uuid(7)) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  status BookingStatus

  /// 1-based queue position while status is LISTA_ESPERA, null otherwise.
  waitlistPosition Int? @map("waitlist_position")

  /// Someone who showed up without answering. Allowed even on a full session.
  isWalkIn Boolean @default(false) @map("is_walk_in")

  /// When the user answered "Vou"/"Não vou" — distinct from attendance.
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(3)

  /// When and by whom attendance was marked (section 6).
  checkedInAt   DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedInById String?   @map("checked_in_by") @db.Uuid

  notes String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User    @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy User?   @relation("BookingCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  /// One answer per user per session; the RSVP endpoint is an idempotent PUT.
  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId, status])
  @@index([userId, status])
  @@map("bookings")
}

// -----------------------------------------------------------------------------
// Settings & audit
// -----------------------------------------------------------------------------

model Setting {
  /// Dotted key from `packages/shared/src/settings.ts`, e.g. `rsvp.windowOpensDaysBefore`.
  key   String @id @db.VarChar(100)
  value Json   @db.JsonB

  updatedById String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Null for anonymous attempts (a blocked login, say).
  actorId String? @map("actor_id") @db.Uuid

  /// Dotted verb, e.g. `user.role.changed`, `attendance.marked`, `super_admin.blocked`.
  action   String  @db.VarChar(100)
  entity   String  @db.VarChar(60)
  entityId String? @map("entity_id") @db.VarChar(64)

  /// `{ before, after }` plus whatever context the action needs.
  metadata Json? @db.JsonB

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
