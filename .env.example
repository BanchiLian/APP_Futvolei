# =============================================================================
# FutCheck — environment variables
# Copy to `.env` at the repository root: cp .env.example .env
# Every variable below is validated with Zod at API startup (apps/api/src/config/env.ts).
# The API refuses to boot if any required value is missing or malformed.
# NEVER commit the real `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=3333
# Public base URL of the API. Used to build links (e.g. password reset e-mails).
API_PUBLIC_URL=http://localhost:3333
# Public base URL of the web app. Used as the target of password reset links.
WEB_PUBLIC_URL=http://localhost:5173
# Business timezone. All "today", "weekday" and deadline logic resolves against it.
BUSINESS_TIMEZONE=America/Sao_Paulo
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (consumed by both Docker Compose and Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER=futcheck
POSTGRES_PASSWORD=futcheck
POSTGRES_DB=futcheck
POSTGRES_PORT=5432
POSTGRES_TZ=America/Sao_Paulo
DATABASE_URL=postgresql://futcheck:futcheck@localhost:5432/futcheck?schema=public
# Separate database used by integration tests. It is dropped and recreated per run.
TEST_DATABASE_URL=postgresql://futcheck:futcheck@localhost:5432/futcheck_test?schema=public

# -----------------------------------------------------------------------------
# Authentication
# Generate strong values with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Access and refresh secrets MUST be different.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
# Short-lived access token.
JWT_ACCESS_TTL=15m
# Rotating refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30
# Name of the httpOnly cookie that carries the refresh token.
REFRESH_TOKEN_COOKIE_NAME=futcheck_rt
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# lax | strict | none — use `none` only when web and API live on different sites over HTTPS.
COOKIE_SAME_SITE=lax
# Leave empty in development; set to the shared parent domain in production.
COOKIE_DOMAIN=
# Password reset token lifetime, in minutes.
PASSWORD_RESET_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# HTTP security
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Global rate limit: requests per window, per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter limit for sign-up and password recovery. NOT applied to /auth/refresh:
# the app refreshes on every page load and a whole arena shares one Wi-Fi address.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Login is limited twice, in the same window: generously per address (an arena
# behind a single IP) and tightly per account (what actually stops guessing).
LOGIN_RATE_LIMIT_MAX_PER_IP=30
LOGIN_RATE_LIMIT_MAX_PER_ACCOUNT=8
# Number of reverse proxies in front of the API (0 = direct). Controls `trust proxy`.
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Super admin — created ONLY by `npm run superadmin:create`.
# There is exactly one SUPER_ADMIN and the API can never create or assign this role.
# Password must have at least 12 characters.
# -----------------------------------------------------------------------------
SUPER_ADMIN_NAME=Dono da Arena
SUPER_ADMIN_EMAIL=dono@futcheck.local
# Optional short handle the owner can log in with instead of the e-mail.
SUPER_ADMIN_USERNAME=admin
# Locally any password works (admin/admin is allowed for development). In
# production it needs 12+ characters, and the API refuses to start if the stored
# password is a well-known one such as "admin".
SUPER_ADMIN_PASSWORD=change-me-min-12-chars

# -----------------------------------------------------------------------------
# Seed — development fixtures only. Never enabled in production.
# -----------------------------------------------------------------------------
# Shared password given to every non-super-admin user created by the seed.
SEED_DEFAULT_PASSWORD=Futcheck@2026

# -----------------------------------------------------------------------------
# File storage (profile pictures)
# -----------------------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
# Where the local driver writes files, relative to apps/api.
STORAGE_LOCAL_DIR=storage/uploads
# Where uploaded images are served from: a path on this origin (development, via
# the Vite proxy) or an absolute CDN URL in production.
STORAGE_PUBLIC_URL=/static
# Only required when STORAGE_DRIVER=s3 (S3 / Cloudflare R2 compatible).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Web app (Vite). Only VITE_-prefixed variables reach the browser bundle.
# Relative on purpose: the dev server proxies /api to the API, so both share one
# origin and the httpOnly refresh cookie survives a reload.
# -----------------------------------------------------------------------------
VITE_API_URL=/api/v1
VITE_APP_NAME=FutCheck
